# DGX single-host deployment: microphone -> ASR -> local DDS -> local Agent.

DDS_DOMAIN_ID=0
SPEECH_TOPIC="rt/g1/hri/speech/final"
PLAYBACK_TOPIC="rt/g1/hri/playback/state"

# This must be the same interface used by the local Agent/Unitree SDK process.
# On the current DGX it is enP7s7 (192.168.123.100/24).
DGX_DDS_IFACE="enP7s7"

# Python 3.11 is recommended for the aarch64 sherpa-onnx and CycloneDDS wheels.
DGX_PYTHON="$HOME/.local/bin/python3.11"
DGX_MIC_DEVICE=""
PROMPT_FOR_MIC_DEVICE=1
REQUIRE_MIC=0

SOURCE_NAME="dgx_mic"
SENSEVOICE_DEVICE="cpu"
SENSEVOICE_THREADS=6
SENSEVOICE_LANGUAGE="zh"
SENSEVOICE_USE_ITN=1

VAD_THRESHOLD=0.5
VAD_PRE_ROLL_SECONDS=0.3
VAD_MIN_SILENCE_SECONDS=0.35
VAD_MIN_SPEECH_SECONDS=0.25
VAD_MAX_SPEECH_SECONDS=10.0

DDS_DELIVERY_TTL_SECONDS=120.0
DDS_OUTBOX_CAPACITY=128
PLAYBACK_RESUME_DELAY_MS=250
PLAYBACK_MAX_ACTIVE_SECONDS=30.0

# Private, user-writable Python DDS dependencies. The C++ unitree_sdk2 directory
# does not provide the unitree_sdk2py module required by this service.
AUTO_INSTALL_UNITREE_SDK=1
CYCLONEDDS_SOURCE_DIR=""
CYCLONEDDS_HOME=""
UNITREE_SDK2_PYTHON_DIR=""

MODEL_SOURCE_DIR=""
SKIP_MODEL_DOWNLOAD=0
UPGRADE_PIP=1
RUN_LATENCY_TEST=1

# Installs a user service without sudo. Keep START_SERVICE=0 until a microphone
# is connected and selected; then rerun with START_SERVICE=1.
INSTALL_USER_SERVICE=1
START_SERVICE=0
