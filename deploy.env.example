# Host-local deployment settings.
#
# Copy this file once, then edit only deploy.env:
#   cp deploy.env.example deploy.env
#
# deploy.env answers "how does this host run the service?". Model selection and
# model-specific tuning belong in JSON profiles such as config.gpu.json or
# config.qwen3-asr.local.json. Never place credentials or robot-vendor SDK
# settings here. The host-local deploy.env and *.local.json files are ignored.

# ---------- Service profiles ----------
# CPU and GPU systemd units keep the same DDS/ROS 2 interfaces. These two paths
# select the model profile loaded by each unit. To switch ASR models, change the
# profile path (and its Python runtime when required), then restart the service.
SPEECH_CONFIG_CPU="config.json"
SPEECH_CONFIG_GPU="config.gpu.json"
RUNTIME_PYTHON="python3"

# Optional isolated GPU Python. Leave empty for .venv-gpu/bin/g1-speech.
SPEECH_PYTHON_GPU=""

# Optional colon-separated library directories required by an isolated GPU
# runtime. This is prepended to LD_LIBRARY_PATH by run-speech-service.
SPEECH_GPU_LIBRARY_PATH=""

# Optional CUDA/Triton settings for a compiled GPU runtime.
CUDA_HOME="/usr/local/cuda"
TRITON_PTXAS_PATH=""
TORCHINDUCTOR_CACHE_DIR=""

# ---------- Audio input (all ASR profiles) ----------
# Empty uses the PortAudio default. A number selects a device index; a string
# selects the first matching device name. Pin a distinctive name on robots with
# USB cameras or several microphones.
MICROPHONE_DEVICE=""
# Ask for a device during interactive setup when MICROPHONE_DEVICE is empty.
PROMPT_FOR_MIC_DEVICE=1

# ---------- Recognition pipeline (all ASR profiles) ----------
# These settings apply equally to SenseVoice, Qwen3-ASR, and external plugins.
# They are applied when configs are generated and again when the service starts,
# so a deploy.env change takes effect after g1-speech-service restart.
VAD_THRESHOLD=0.35
VAD_PRE_ROLL_SECONDS=0.5
VAD_MIN_SILENCE_SECONDS=0.35
VAD_MIN_SPEECH_SECONDS=0.15
VAD_MAX_SPEECH_SECONDS=10.0

# Suppress recognition while the robot is speaking, then wait briefly before
# reopening the microphone path.
PLAYBACK_RESUME_DELAY_MS=250
PLAYBACK_MAX_ACTIVE_SECONDS=30.0

# ---------- DDS transport (all ASR profiles) ----------
SPEECH_TRANSPORT="dds"
DDS_DOMAIN_ID=0
# Empty lets Cyclone DDS select an interface automatically.
DDS_NETWORK_INTERFACE=""
SPEECH_TOPIC="rt/g1/hri/speech/final"
PLAYBACK_TOPIC="rt/g1/hri/playback/state"
DDS_DELIVERY_TTL_SECONDS=120.0
DDS_OUTBOX_CAPACITY=128

# ---------- ROS 2 transport (all ASR profiles) ----------
# The service selector passes dds|ros2 explicitly. These values configure ROS 2
# discovery and topics when ROS 2 is selected.
ROS2_DOMAIN_ID=""
ROS2_NODE_NAME="g1_speech"
ROS2_SPEECH_TOPIC="hri/speech/final"
ROS2_PLAYBACK_TOPIC="hri/playback/state"
ROS2_QOS_DEPTH=10
ROS2_SETUP=""
ROS2_WORKSPACE_SETUP=""

# ---------- Dependency installation ----------
AUTO_INSTALL_CYCLONEDDS=1
CYCLONEDDS_SOURCE_DIR="$HOME/.cache/g1-speech/cyclonedds"
CYCLONEDDS_HOME="$HOME/.cache/g1-speech/cyclonedds/install"

# Optional offline source containing silero_vad.onnx and a SenseVoice model.
MODEL_SOURCE_DIR=""
SKIP_MODEL_DOWNLOAD=0

# ---------- Installer behavior ----------
SKIP_APT=0
UPGRADE_PIP=1
RUN_LATENCY_TEST=1
INSTALL_SYSTEMD=1
# Empty uses the account running the setup script.
SYSTEMD_USER=""
# Optional systemd [Service] drop-in for PulseAudio/ALSA environment variables.
SYSTEMD_AUDIO_DROPIN=""
