# G1 Speech Service deployment variables.
# Copy this file on the speech host, then edit values for the local machine:
#   cp deploy.env.example deploy.env
#
# No API keys or robot credentials belong in this file.
# Runtime defaults are generated by `g1-speech config init` and documented in
# config.example.json. Define only the optional overrides you need here.

# ---------- DDS ----------
# Optional. Use a local interface visible in:
#   ip -br link
# Leave empty to let Cyclone DDS choose automatically.
DDS_NETWORK_INTERFACE=""
# Other optional DDS overrides:
#   DDS_DOMAIN_ID, SPEECH_TOPIC, PLAYBACK_TOPIC,
#   DDS_DELIVERY_TTL_SECONDS, DDS_OUTBOX_CAPACITY

# ---------- Runtime ----------
RUNTIME_PYTHON="python3"

# Empty means the PortAudio default input. A number selects the index printed by:
#   .venv/bin/python -c 'import sounddevice as sd; print(sd.query_devices())'
# A device-name string is also accepted, for example "USB Microphone".
MICROPHONE_DEVICE=""
# When the device is empty, ask for an input in an interactive terminal.
PROMPT_FOR_MIC_DEVICE=1

# Optional recognition and VAD overrides:
#   SENSEVOICE_DEVICE, SENSEVOICE_THREADS, SENSEVOICE_LANGUAGE,
#   SENSEVOICE_USE_ITN, VAD_THRESHOLD, VAD_PRE_ROLL_SECONDS,
#   VAD_MIN_SILENCE_SECONDS, VAD_MIN_SPEECH_SECONDS,
#   VAD_MAX_SPEECH_SECONDS
# Optional playback overrides:
#   PLAYBACK_RESUME_DELAY_MS, PLAYBACK_MAX_ACTIVE_SECONDS

# Build and install Cyclone DDS when it is not already available.
AUTO_INSTALL_CYCLONEDDS=1
CYCLONEDDS_SOURCE_DIR="$HOME/.cache/g1-speech/cyclonedds"
CYCLONEDDS_HOME="$HOME/.cache/g1-speech/cyclonedds/install"

# Optional offline model source. It should contain silero_vad.onnx and a
# sherpa-onnx-sense-voice-* directory. Empty means download missing models.
MODEL_SOURCE_DIR=""
SKIP_MODEL_DOWNLOAD=0

# ---------- Installation ----------
SKIP_APT=0
UPGRADE_PIP=1
RUN_LATENCY_TEST=1
INSTALL_SYSTEMD=1
# Empty uses the account running the setup script.
SYSTEMD_USER=""
# Optional path to a generic systemd [Service] drop-in for audio environment
# variables such as PULSE_SERVER or ALSA_CONFIG_PATH. Applied to both backends.
SYSTEMD_AUDIO_DROPIN=""
