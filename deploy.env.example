# Host-local deployment settings.
#
# Copy this file once, then edit only deploy.env:
#   cp deploy.env.example deploy.env
#
# deploy.env answers "how does this host run the service?". Model selection and
# model-specific tuning belong in JSON profiles such as config.gpu.json or
# config.qwen3-asr.local.json. Never place credentials or robot-vendor SDK
# settings here. The host-local deploy.env and *.local.json files are ignored.

# ---------- Service profiles ----------
# CPU and GPU systemd units keep the same DDS/ROS 2 interfaces. These two paths
# select the model profile loaded by each unit. To switch ASR models, change the
# profile path (and its Python runtime when required), then restart the service.
SPEECH_CONFIG_CPU="config.json"
SPEECH_CONFIG_GPU="config.gpu.json"
RUNTIME_PYTHON="python3"

# Optional isolated GPU Python. Leave empty for .venv-gpu/bin/g1-speech.
SPEECH_PYTHON_GPU=""

# Optional colon-separated library directories required by an isolated GPU
# runtime. This is prepended to LD_LIBRARY_PATH by run-speech-service.
SPEECH_GPU_LIBRARY_PATH=""

# Optional CUDA/Triton settings for a compiled GPU runtime.
CUDA_HOME="/usr/local/cuda"
TRITON_PTXAS_PATH=""
TORCHINDUCTOR_CACHE_DIR=""

# ---------- Audio input (all ASR profiles) ----------
# ALSA hardware access is the low-latency primary path. ALSA_INPUT_CARD is the
# stable card ID from /proc/asound/card*/id (for example: Microphone), never the
# hot-plug-sensitive number from hw:1,0. Empty enables unambiguous auto-detection.
AUDIO_INPUT_BACKEND="alsa"
AUDIO_INPUT_FALLBACK=""
ALSA_INPUT_CARD=""
ALSA_INPUT_DEVICE=0
# Native capture format. Most USB wireless microphones expose 48 kHz stereo;
# conversion to the ASR pipeline's 16 kHz mono happens outside the callback.
ALSA_INPUT_SAMPLE_RATE=48000
ALSA_INPUT_CHANNELS=2
ALSA_INPUT_DTYPE="int16"
# Used only when PulseAudio is selected explicitly. "pulse" follows its default
# source; a PortAudio device index or matching name is also accepted.
PULSE_INPUT_DEVICE="pulse"
# Optional stable PulseAudio source name from `pactl list short sources`.
PULSE_SOURCE=""
# 20 ms is the robot baseline. Increase it if the device reports overflows.
AUDIO_INPUT_BLOCK_MS=20
# PortAudio accepts low, high, or a positive latency value in seconds.
AUDIO_INPUT_LATENCY="low"
# Ask for the stable ALSA card ID during interactive setup when it is empty.
PROMPT_FOR_MIC_DEVICE=1

# ---------- Audio processing (all ASR profiles) ----------
# off: half-duplex playback gate; hardware: microphone DSP provides AEC/NS;
# webrtc: software AEC3/NS receives the actual speaker PCM as render reference.
AUDIO_PROCESSING_MODE="off"
WEBRTC_AEC_STREAM_DELAY_MS=80
WEBRTC_AEC_ENABLED=1
WEBRTC_NS_ENABLED=1
WEBRTC_NS_LEVEL=2
WEBRTC_AGC_ENABLED=0

# ---------- Audio output / TTS host settings ----------
# Like ALSA_INPUT_CARD, use a stable ID from /proc/asound/card*/id. Empty is
# accepted only when exactly one hardware output exists.
ALSA_OUTPUT_CARD=""
ALSA_OUTPUT_DEVICE=0
ALSA_OUTPUT_SAMPLE_RATE=48000
ALSA_OUTPUT_CHANNELS=2
AUDIO_OUTPUT_BLOCK_MS=10
AUDIO_OUTPUT_LATENCY="low"
AUDIO_OUTPUT_VOLUME=1.0
# Bounded continuous PCM look-ahead. Generation blocks only when this buffer is full.
AUDIO_OUTPUT_BUFFER_SECONDS=8.0
# "persistent" clears the software timeline without tearing down PortAudio.
# Use "hard_abort" only as the JP6.2 rollback/A-B path.
AUDIO_OUTPUT_INTERRUPT_STRATEGY="persistent"
# Model/task/voice defaults live in the JSON profile; these switches describe
# this host and its local vLLM-Omni endpoint.
TTS_ENABLED=0
TTS_WEBSOCKET_URL="ws://127.0.0.1:8091/v1/audio/speech/stream"
TTS_VOICE="Ryan"
TTS_LANGUAGE="Auto"

# ---------- Recognition pipeline (all ASR profiles) ----------
# These settings apply equally to SenseVoice, Qwen3-ASR, and external plugins.
# They are applied when configs are generated and again when the service starts,
# so a deploy.env change takes effect after g1-speech-service restart.
VAD_THRESHOLD=0.35
VAD_PRE_ROLL_SECONDS=0.5
VAD_MIN_SILENCE_SECONDS=0.35
VAD_MIN_SPEECH_SECONDS=0.15
VAD_MAX_SPEECH_SECONDS=10.0

# Suppress recognition while the robot is speaking, then wait briefly before
# reopening the microphone path.
PLAYBACK_RESUME_DELAY_MS=250
PLAYBACK_MAX_ACTIVE_SECONDS=30.0

# ---------- DDS transport (all ASR profiles) ----------
SPEECH_TRANSPORT="dds"
DDS_DOMAIN_ID=0
# Empty lets Cyclone DDS select an interface automatically.
DDS_NETWORK_INTERFACE=""
SPEECH_TOPIC="rt/g1/hri/speech/final"
PLAYBACK_TOPIC="rt/g1/hri/playback/state"
TTS_TOPIC="rt/g1/hri/tts/request"
CONTROL_TOPIC="rt/g1/hri/control/epoch"
DDS_DELIVERY_TTL_SECONDS=120.0
DDS_OUTBOX_CAPACITY=128

# ---------- ROS 2 transport (all ASR profiles) ----------
# The service selector passes dds|ros2 explicitly. These values configure ROS 2
# discovery and topics when ROS 2 is selected.
ROS2_DOMAIN_ID=""
ROS2_NODE_NAME="g1_speech"
ROS2_SPEECH_TOPIC="hri/speech/final"
ROS2_PLAYBACK_TOPIC="hri/playback/state"
ROS2_TTS_TOPIC="hri/tts/request"
ROS2_CONTROL_TOPIC="hri/control/epoch"
ROS2_QOS_DEPTH=10
ROS2_SETUP=""
ROS2_WORKSPACE_SETUP=""

# ---------- Dependency installation ----------
AUTO_INSTALL_CYCLONEDDS=1
CYCLONEDDS_SOURCE_DIR="$HOME/.cache/g1-speech/cyclonedds"
CYCLONEDDS_HOME="$HOME/.cache/g1-speech/cyclonedds/install"

# Optional offline source containing silero_vad.onnx and a SenseVoice model.
MODEL_SOURCE_DIR=""
SKIP_MODEL_DOWNLOAD=0

# ---------- Installer behavior ----------
SKIP_APT=0
UPGRADE_PIP=1
RUN_LATENCY_TEST=1
INSTALL_SYSTEMD=1
# Empty uses the account running the setup script.
SYSTEMD_USER=""
# Optional systemd [Service] drop-in for PulseAudio/ALSA environment variables.
SYSTEMD_AUDIO_DROPIN=""
