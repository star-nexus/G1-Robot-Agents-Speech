# G1 Speech Service deployment variables.
# Copy to deploy.env on BOTH machines, then edit the values for your setup:
#   cp deploy.env.example deploy.env
#
# This file contains no API keys. Do not add OpenAI or robot credentials here.

# ---------- Shared DDS/network settings ----------
# Both hosts must use the same DDS domain and topic names.
DDS_DOMAIN_ID=0
SPEECH_TOPIC="rt/g1/hri/speech/final"
PLAYBACK_TOPIC="rt/g1/hri/playback/state"

# Both machines are expected to be in the existing 192.168.123.x network.
ORIN_HOST="192.168.123.XXX"
ORIN_USER="unitree"
ORIN_DDS_IFACE="eth0"

SPARK_HOST="192.168.123.YYY"
SPARK_USER="spark"
SPARK_DDS_IFACE="enp3s0"

# ---------- Orin installation ----------
ORIN_PYTHON="python3"

# Empty means the PortAudio default input. A number selects the index printed by:
#   .venv/bin/python -c 'import sounddevice as sd; print(sd.query_devices())'
# It can also be a device-name string, e.g. ORIN_MIC_DEVICE="USB Microphone".
ORIN_MIC_DEVICE=""
# With an empty ORIN_MIC_DEVICE, setup-orin.sh can ask you to select from the
# detected PortAudio inputs when run in an interactive terminal.
PROMPT_FOR_MIC_DEVICE=1

# Match the already validated moyun_zhihe configuration.
SENSEVOICE_DEVICE="cpu"
SENSEVOICE_THREADS=6
SENSEVOICE_LANGUAGE="zh"
SENSEVOICE_USE_ITN=1

VAD_THRESHOLD=0.5
VAD_PRE_ROLL_SECONDS=0.3
VAD_MIN_SILENCE_SECONDS=0.35
VAD_MIN_SPEECH_SECONDS=0.25
VAD_MAX_SPEECH_SECONDS=10.0

DDS_DELIVERY_TTL_SECONDS=120.0
DDS_OUTBOX_CAPACITY=128
PLAYBACK_RESUME_DELAY_MS=250
PLAYBACK_MAX_ACTIVE_SECONDS=30.0

# Set to 1 only if unitree_sdk2py/cyclonedds is missing and Internet is available.
# With 0, setup-orin.sh stops with exact manual recovery instructions.
AUTO_INSTALL_UNITREE_SDK=0
CYCLONEDDS_SOURCE_DIR="$HOME/cyclonedds"
CYCLONEDDS_HOME="$HOME/cyclonedds/install"
UNITREE_SDK2_PYTHON_DIR="$HOME/unitree_sdk2_python"

# Optional offline model source. It should contain silero_vad.onnx and the
# sherpa-onnx-sense-voice-* directory. Empty means download missing models.
MODEL_SOURCE_DIR=""
SKIP_MODEL_DOWNLOAD=0

# Installation controls.
SKIP_APT=0
UPGRADE_PIP=1
RUN_LATENCY_TEST=1
# Default 1: install, enable, and immediately start the Orin service.
# Set 0 only when you want to run g1-speech serve manually.
INSTALL_SYSTEMD=1
ORIN_SYSTEMD_USER="unitree"

# ---------- Spark installation ----------
# IMPORTANT: Point this at the exact Python executable used by the competition Agent.
# Examples:
#   /home/spark/miniconda3/envs/g1-agent/bin/python
#   /home/spark/agent/.venv/bin/python
SPARK_AGENT_PYTHON="/home/spark/miniconda3/envs/g1-agent/bin/python"

# setup-spark.sh uses --no-deps and never edits the Agent source tree.
SPARK_INSTALL_NO_DEPS=1

# ---------- Dual-host verification ----------
# Run verify-dual.sh on Spark. SSH access from Spark to Orin is required.
ORIN_INSTALL_DIR="/home/unitree/speech_service"
ORIN_SERVICE_NAME="g1-speech"
VERIFY_SPEECH_SECONDS=15
