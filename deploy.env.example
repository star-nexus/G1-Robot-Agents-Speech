# Robot speech service deployment variables.
# Copy this file on the speech host, then edit values for the local machine:
#   cp deploy.env.example deploy.env
#
# No API keys or robot credentials belong in this file.
# No robot-vendor SDK, host address, username, or absolute model path belongs
# in this shared example; keep host-specific values in the ignored deploy.env.
# Runtime defaults are generated by `g1-speech config init` and documented in
# config.example.json. Define only the optional overrides you need here.

# ---------- DDS ----------
# Optional. Use a local interface visible in:
#   ip -br link
# Leave empty to let Cyclone DDS choose automatically.
DDS_NETWORK_INTERFACE=""
# Other optional DDS overrides:
#   DDS_DOMAIN_ID, SPEECH_TOPIC, PLAYBACK_TOPIC,
#   DDS_DELIVERY_TTL_SECONDS, DDS_OUTBOX_CAPACITY

# ---------- Runtime ----------
RUNTIME_PYTHON="python3"

# Optional service configuration selection. This makes ASR model switching a
# deploy-time configuration change; the systemd units and ROS 2/DDS consumers
# stay unchanged. Relative paths are resolved from the project root.
# SPEECH_CONFIG_GPU="config.qwen3-asr-0.6b.local.json"
# SPEECH_CONFIG_CPU="config.json"

# Transport used when running g1-speech directly. The systemd selector chooses
# its transport explicitly and does not modify this value.
SPEECH_TRANSPORT="dds"
# Optional ROS 2 overrides:
#   ROS2_NODE_NAME, ROS2_SPEECH_TOPIC, ROS2_PLAYBACK_TOPIC, ROS2_QOS_DEPTH
# The installer preserves ROS_DOMAIN_ID from the setup shell. Set an explicit
# value here when the service should use a different ROS graph.
# ROS2_DOMAIN_ID=0
# Set these only when automatic ROS 2 discovery is not appropriate:
# ROS2_SETUP="/opt/ros/humble/setup.bash"
# ROS2_WORKSPACE_SETUP="/path/to/ros2_ws/install/setup.bash"

# Empty means the PortAudio default input. USB cameras often expose their own
# microphone and desktop audio systems may automatically make a newly connected
# device the default. Robot deployments should therefore pin a distinctive
# device-name substring instead of relying on the default or a changeable index.
# A number selects the index printed by:
#   .venv/bin/python -c 'import sounddevice as sd; print(sd.query_devices())'
# A device-name string is also accepted, for example "USB Microphone".
MICROPHONE_DEVICE=""
# When the device is empty, ask for an input in an interactive terminal.
PROMPT_FOR_MIC_DEVICE=1

# Optional recognition and VAD overrides (used by `config init --from-env`):
#   ASR_BACKEND, SENSEVOICE_DEVICE, SENSEVOICE_THREADS, SENSEVOICE_LANGUAGE,
#   SENSEVOICE_USE_ITN, VAD_THRESHOLD, VAD_PRE_ROLL_SECONDS,
#   VAD_MIN_SILENCE_SECONDS, VAD_MIN_SPEECH_SECONDS,
#   VAD_MAX_SPEECH_SECONDS
# Qwen3-ASR overrides:
#   QWEN3_ASR_MODEL_DIR, QWEN3_ASR_DEVICE, QWEN3_ASR_DTYPE,
#   QWEN3_ASR_LANGUAGE, QWEN3_ASR_PROMPT, QWEN3_ASR_MAX_NEW_TOKENS,
#   QWEN3_ASR_ATTENTION, QWEN3_ASR_QUANTIZATION
# Optional playback overrides:
#   PLAYBACK_RESUME_DELAY_MS, PLAYBACK_MAX_ACTIVE_SECONDS

# Build and install Cyclone DDS when it is not already available.
AUTO_INSTALL_CYCLONEDDS=1
CYCLONEDDS_SOURCE_DIR="$HOME/.cache/g1-speech/cyclonedds"
CYCLONEDDS_HOME="$HOME/.cache/g1-speech/cyclonedds/install"

# Optional offline model source. It should contain silero_vad.onnx and a
# sherpa-onnx-sense-voice-* directory. Empty means download missing models.
MODEL_SOURCE_DIR=""
SKIP_MODEL_DOWNLOAD=0

# ---------- Installation ----------
SKIP_APT=0
UPGRADE_PIP=1
RUN_LATENCY_TEST=1
INSTALL_SYSTEMD=1
# Empty uses the account running the setup script.
SYSTEMD_USER=""
# Optional path to a generic systemd [Service] drop-in for audio environment
# variables such as PULSE_SERVER or ALSA_CONFIG_PATH. Applied to every mode.
SYSTEMD_AUDIO_DROPIN=""
