#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND="${1:-}"
TRANSPORT="${2:-dds}"

if [[ -f "$ROOT/deploy.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$ROOT/deploy.env"
    set +a
fi

if [[ -n "${CYCLONEDDS_HOME:-}" && ! -f "$CYCLONEDDS_HOME/lib/libddsc.so" ]]; then
    echo "[FAIL] CycloneDDS runtime is missing: $CYCLONEDDS_HOME/lib/libddsc.so" >&2
    echo "       Repair with: bash $ROOT/scripts/install-cyclonedds.sh $ROOT/.venv-gpu/bin/python" >&2
    exit 1
fi

case "$BACKEND" in
    cpu)
        COMMAND=("$ROOT/.venv/bin/g1-speech")
        CONFIG="${SPEECH_CONFIG_CPU:-$ROOT/config.json}"
        ;;
    gpu)
        if [[ -n "${SPEECH_PYTHON_GPU:-}" ]]; then
            COMMAND=("$SPEECH_PYTHON_GPU" -m g1_speech.cli)
            export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
            if [[ -n "${CUDA_HOME:-}" ]]; then
                CUDA_INCLUDE="$CUDA_HOME/include:$CUDA_HOME/targets/aarch64-linux/include"
                export CPATH="$CUDA_INCLUDE${CPATH:+:$CPATH}"
                export CPLUS_INCLUDE_PATH="$CUDA_INCLUDE${CPLUS_INCLUDE_PATH:+:$CPLUS_INCLUDE_PATH}"
            fi
        else
            COMMAND=("$ROOT/.venv-gpu/bin/g1-speech")
        fi
        CONFIG="${SPEECH_CONFIG_GPU:-$ROOT/config.gpu.json}"
        ;;
    *)
        echo "[FAIL] Backend must be cpu or gpu." >&2
        exit 2
        ;;
esac

if [[ -n "${QWEN3_CUDSS_DIR:-}" ]]; then
    export LD_LIBRARY_PATH="$QWEN3_CUDSS_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [[ -n "${CYCLONEDDS_HOME:-}" ]]; then
    export LD_LIBRARY_PATH="$CYCLONEDDS_HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

if [[ "$CONFIG" != /* ]]; then
    CONFIG="$ROOT/$CONFIG"
fi

case "$TRANSPORT" in
    dds) ;;
    ros2)
        if [[ -n "${ROS2_DOMAIN_ID:-}" ]]; then
            export ROS_DOMAIN_ID="$ROS2_DOMAIN_ID"
        fi
        # shellcheck disable=SC1091
        source "$ROOT/scripts/ros2-environment.sh"
        source_ros2_base
        source_ros2_overlay "$ROOT"
        ;;
    *)
        echo "[FAIL] Transport must be dds or ros2." >&2
        exit 2
        ;;
esac

[[ -x "${COMMAND[0]}" ]] || { echo "[FAIL] Runtime is missing: ${COMMAND[0]}" >&2; exit 1; }
[[ -f "$CONFIG" ]] || { echo "[FAIL] Config is missing: $CONFIG" >&2; exit 1; }

exec "${COMMAND[@]}" serve --config "$CONFIG" --transport "$TRANSPORT"
