#!/usr/bin/env bash
set -Eeuo pipefail

CPU_UNIT="g1-speech.service"
GPU_UNIT="g1-speech-gpu.service"

usage() {
    cat <<'EOF'
Usage:
  sudo g1-speech-service cpu       Start CPU INT8 and enable it at boot
  sudo g1-speech-service gpu       Start GPU FP32 and enable it at boot
  sudo g1-speech-service stop      Stop and disable both backends
  sudo g1-speech-service restart   Restart the active backend
  g1-speech-service status         Show the selected backend
  g1-speech-service logs [cpu|gpu] Follow service logs
EOF
}

require_root() {
    if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
        echo "[FAIL] This action requires sudo." >&2
        exit 1
    fi
}

unit_state() {
    systemctl is-active "$1" 2>/dev/null || true
}

show_status() {
    local cpu_state gpu_state
    cpu_state="$(unit_state "$CPU_UNIT")"
    gpu_state="$(unit_state "$GPU_UNIT")"
    printf 'CPU INT8: %s\nGPU FP32: %s\n' "$cpu_state" "$gpu_state"
    if [[ "$cpu_state" == "active" && "$gpu_state" == "active" ]]; then
        echo "Selected: ERROR (both backends are active)"
        return 1
    elif [[ "$cpu_state" == "active" ]]; then
        echo "Selected: cpu"
    elif [[ "$gpu_state" == "active" ]]; then
        echo "Selected: gpu"
    else
        echo "Selected: stopped"
    fi
}

select_backend() {
    local selected="$1" other="$2" label="$3"
    require_root
    systemctl disable --now "$other" >/dev/null 2>&1 || true
    systemctl enable --now "$selected"
    systemctl is-active --quiet "$selected"
    echo "[PASS] Active backend: $label"
}

resolve_unit() {
    case "$1" in
        cpu) echo "$CPU_UNIT" ;;
        gpu) echo "$GPU_UNIT" ;;
        *) echo "[FAIL] Backend must be cpu or gpu." >&2; exit 2 ;;
    esac
}

command="${1:-status}"
case "$command" in
    cpu)
        select_backend "$CPU_UNIT" "$GPU_UNIT" "CPU INT8"
        ;;
    gpu)
        select_backend "$GPU_UNIT" "$CPU_UNIT" "GPU FP32"
        ;;
    stop)
        require_root
        systemctl disable --now "$CPU_UNIT" "$GPU_UNIT" >/dev/null 2>&1 || true
        echo "[PASS] Both speech backends are stopped and disabled."
        ;;
    restart)
        require_root
        cpu_state="$(unit_state "$CPU_UNIT")"
        gpu_state="$(unit_state "$GPU_UNIT")"
        if [[ "$cpu_state" == "active" && "$gpu_state" != "active" ]]; then
            systemctl restart "$CPU_UNIT"
        elif [[ "$gpu_state" == "active" && "$cpu_state" != "active" ]]; then
            systemctl restart "$GPU_UNIT"
        else
            echo "[FAIL] Exactly one backend must be active." >&2
            exit 1
        fi
        show_status
        ;;
    status)
        show_status
        ;;
    logs)
        backend="${2:-}"
        if [[ -z "$backend" ]]; then
            if [[ "$(unit_state "$GPU_UNIT")" == "active" ]]; then
                backend="gpu"
            else
                backend="cpu"
            fi
        fi
        exec journalctl -u "$(resolve_unit "$backend")" -f
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
