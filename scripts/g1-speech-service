#!/usr/bin/env bash
set -Eeuo pipefail

CPU_DDS_UNIT="g1-speech.service"
GPU_DDS_UNIT="g1-speech-gpu.service"
CPU_ROS2_UNIT="g1-speech-ros2.service"
GPU_ROS2_UNIT="g1-speech-gpu-ros2.service"
ALL_UNITS=("$CPU_DDS_UNIT" "$GPU_DDS_UNIT" "$CPU_ROS2_UNIT" "$GPU_ROS2_UNIT")

usage() {
    cat <<'EOF'
Usage:
  sudo g1-speech-service cpu [dds|ros2]   Select CPU INT8 (DDS by default)
  sudo g1-speech-service gpu [dds|ros2]   Select GPU FP32 (DDS by default)
  sudo g1-speech-service stop             Stop and disable speech recognition
  sudo g1-speech-service restart          Restart the selected service
  g1-speech-service status                Show all modes and current selection
  g1-speech-service logs [cpu|gpu] [dds|ros2]
                                             Follow selected or specified logs

Examples:
  sudo g1-speech-service gpu ros2
  sudo g1-speech-service cpu dds
  g1-speech-service logs
EOF
}

require_root() {
    if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
        echo "[FAIL] This action requires sudo." >&2
        exit 1
    fi
}

unit_state() {
    local state
    state="$(systemctl is-active "$1" 2>/dev/null || true)"
    [[ -n "$state" ]] && printf '%s\n' "$state" || printf '%s\n' "not-installed"
}

resolve_unit() {
    local backend="$1" transport="${2:-dds}"
    case "$backend:$transport" in
        cpu:dds) echo "$CPU_DDS_UNIT" ;;
        gpu:dds) echo "$GPU_DDS_UNIT" ;;
        cpu:ros2) echo "$CPU_ROS2_UNIT" ;;
        gpu:ros2) echo "$GPU_ROS2_UNIT" ;;
        *) echo "[FAIL] Expected backend cpu|gpu and transport dds|ros2." >&2; exit 2 ;;
    esac
}

unit_label() {
    case "$1" in
        "$CPU_DDS_UNIT") echo "cpu + dds" ;;
        "$GPU_DDS_UNIT") echo "gpu + dds" ;;
        "$CPU_ROS2_UNIT") echo "cpu + ros2" ;;
        "$GPU_ROS2_UNIT") echo "gpu + ros2" ;;
        *) return 1 ;;
    esac
}

unit_is_selected() {
    local unit="$1" state
    state="$(unit_state "$unit")"
    case "$state" in
        active|activating|reloading|deactivating) return 0 ;;
    esac
    systemctl is-enabled --quiet "$unit" 2>/dev/null
}

selected_unit() {
    local unit found=""
    for unit in "${ALL_UNITS[@]}"; do
        if unit_is_selected "$unit"; then
            if [[ -n "$found" ]]; then
                echo "[FAIL] Multiple speech services are selected." >&2
                return 1
            fi
            found="$unit"
        fi
    done
    [[ -n "$found" ]] || return 1
    printf '%s\n' "$found"
}

unit_working_directory() {
    systemctl show "$1" --property=WorkingDirectory --value 2>/dev/null || true
}

configured_microphone() {
    local unit="$1" pid environment_line device root config python
    pid="$(systemctl show "$unit" --property=MainPID --value 2>/dev/null || true)"
    if [[ "$pid" =~ ^[1-9][0-9]*$ && -r "/proc/$pid/environ" ]]; then
        environment_line="$(
            tr '\0' '\n' <"/proc/$pid/environ" \
                | sed -n '/^MICROPHONE_DEVICE=/{p;q;}' || true
        )"
        if [[ "$environment_line" == MICROPHONE_DEVICE=* ]]; then
            device="${environment_line#MICROPHONE_DEVICE=}"
            [[ -n "$device" ]] && printf '%s\n' "$device" || printf '%s\n' "default"
            return
        fi
    fi

    root="$(unit_working_directory "$unit")"
    [[ -n "$root" ]] || { printf '%s\n' "unknown"; return; }
    case "$unit" in
        "$GPU_DDS_UNIT"|"$GPU_ROS2_UNIT") config="$root/config.gpu.json" ;;
        *) config="$root/config.json" ;;
    esac
    if [[ -x "$root/.venv/bin/python" ]]; then
        python="$root/.venv/bin/python"
    elif command -v python3 >/dev/null 2>&1; then
        python="$(command -v python3)"
    else
        printf '%s\n' "unknown"
        return
    fi
    "$python" - "$config" <<'PY' 2>/dev/null || printf '%s\n' "unknown"
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        device = json.load(stream).get("audio", {}).get("device")
except (OSError, ValueError):
    device = "unknown"
print("default" if device is None or device == "" else device)
PY
}

show_microphone() {
    local unit="$1" device pulse_source
    device="$(configured_microphone "$unit")"
    case "$device" in
        pulse|default)
            echo "Microphone: $device (follows the system default input)"
            if command -v pactl >/dev/null 2>&1; then
                pulse_source="$(pactl get-default-source 2>/dev/null || true)"
                [[ -n "$pulse_source" ]] && echo "Audio source: $pulse_source"
            fi
            echo "Warning: USB cameras may change the default input; pin MICROPHONE_DEVICE in deploy.env."
            ;;
        unknown)
            echo "Microphone: unknown"
            ;;
        *)
            echo "Microphone: $device (pinned)"
            ;;
    esac
}

show_status() {
    local unit selected state
    printf '%-12s %s\n' "CPU + DDS:" "$(unit_state "$CPU_DDS_UNIT")"
    printf '%-12s %s\n' "GPU + DDS:" "$(unit_state "$GPU_DDS_UNIT")"
    printf '%-12s %s\n' "CPU + ROS 2:" "$(unit_state "$CPU_ROS2_UNIT")"
    printf '%-12s %s\n' "GPU + ROS 2:" "$(unit_state "$GPU_ROS2_UNIT")"
    if unit="$(selected_unit 2>/dev/null)"; then
        selected="$(unit_label "$unit")"
        echo "Selected: $selected"
        state="$(unit_state "$unit")"
        if [[ "$state" == "active" ]]; then
            show_microphone "$unit"
        else
            echo "Health: $state (run: g1-speech-service logs)"
        fi
    else
        echo "Selected: stopped"
    fi
}

select_mode() {
    local backend="$1" transport="${2:-dds}" selected unit
    require_root
    selected="$(resolve_unit "$backend" "$transport")"
    systemctl cat "$selected" >/dev/null 2>&1 || {
        echo "[FAIL] $backend + $transport is not installed." >&2
        if [[ "$transport" == "ros2" ]]; then
            echo "       Run: bash scripts/setup-ros2.sh" >&2
        fi
        exit 1
    }
    for unit in "${ALL_UNITS[@]}"; do
        [[ "$unit" == "$selected" ]] || systemctl disable --now "$unit" >/dev/null 2>&1 || true
    done
    systemctl enable --now "$selected"
    systemctl is-active --quiet "$selected"
    echo "[PASS] Active mode: $(unit_label "$selected")"
}

command="${1:-status}"
case "$command" in
    cpu|gpu)
        select_mode "$command" "${2:-dds}"
        ;;
    stop)
        require_root
        systemctl disable --now "${ALL_UNITS[@]}" >/dev/null 2>&1 || true
        echo "[PASS] Speech recognition is stopped and disabled."
        ;;
    restart)
        require_root
        if unit="$(selected_unit)"; then
            systemctl restart "$unit"
            state="$(unit_state "$unit")"
            if [[ "$state" == "active" ]]; then
                echo "[PASS] Restarted: $(unit_label "$unit")"
            else
                echo "[WARN] Restart requested: $(unit_label "$unit") (state: $state)" >&2
                echo "       Inspect: g1-speech-service logs" >&2
            fi
        else
            echo "[FAIL] Exactly one speech service must be selected." >&2
            exit 1
        fi
        ;;
    status)
        show_status
        ;;
    logs)
        if [[ -n "${2:-}" ]]; then
            unit="$(resolve_unit "$2" "${3:-dds}")"
        elif ! unit="$(selected_unit)"; then
            echo "[FAIL] No speech service is selected; specify cpu|gpu and optionally dds|ros2." >&2
            exit 1
        fi
        show_microphone "$unit"
        exec journalctl -u "$unit" -f
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
