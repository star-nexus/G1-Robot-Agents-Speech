[Unit]
Description=DGX local SenseVoice DDS service
After=default.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@PYTHON@ @ROOT@/.venv/bin/g1-speech serve --config @ROOT@/config.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=@RUNTIME_LIBRARY_PATH@
Environment=LIBRARY_PATH=@RUNTIME_LIBRARY_PATH@

[Install]
WantedBy=default.target
