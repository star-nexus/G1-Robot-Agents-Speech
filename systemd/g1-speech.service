[Unit]
Description=Offline speech recognition for robot Agents (CPU INT8, DDS)
After=network-online.target sound.target
Wants=network-online.target
Conflicts=g1-speech-gpu.service g1-speech-ros2.service g1-speech-gpu-ros2.service

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/usr/bin/bash @PROJECT_ROOT@/scripts/run-speech-service cpu dds
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
