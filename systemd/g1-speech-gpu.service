[Unit]
Description=Offline speech recognition for robot Agents (GPU FP32, DDS)
After=network-online.target sound.target
Wants=network-online.target
Conflicts=g1-speech.service g1-speech-ros2.service g1-speech-gpu-ros2.service
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/usr/bin/bash @PROJECT_ROOT@/scripts/run-speech-service gpu dds
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
