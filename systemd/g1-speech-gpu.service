[Unit]
Description=Offline SenseVoice DDS service for robot Agents (GPU FP32)
After=network-online.target sound.target
Wants=network-online.target
Conflicts=g1-speech.service

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/.venv-gpu/bin/g1-speech serve --config @PROJECT_ROOT@/config.gpu.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
