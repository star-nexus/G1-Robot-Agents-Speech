    "buffer_seconds": 30.0
  },
  "sensevoice": {
    "model_dir": "models",
    "device": "cpu",
    "language": "zh",
    "use_itn": true,
    "num_threads": 4
  },
  "dds": {
    "domain_id": 0,
    "network_interface": "eth0",
    "speech_topic": "rt/g1/hri/speech/final",
    "playback_topic": "rt/g1/hri/playback/state",
    "write_timeout_seconds": 0.5,
